    {
      "id": "fr-ctc",
      "label": "France e-invoicing reform (BR-FR)",
      "country": "FR",
      "description": "French business rules (AFNOR XP Z12-012, published by FNFE-MPE). Applied to French invoice profiles and to domestic FR\u2192FR invoices.",
      "documentTypes": [
        "Invoice",
        "CreditNote"
      ],
      "match": [
        {
          "customizationId": {
            "equals": "urn:cen.eu:en16931:2017"
          },
          "profileId": {
            "regex": "^[SBM][0-9]+$"
          }
        },
        {
          "profileId": {
            "startsWith": "urn:peppol:france:billing"
          }
        },
        {
          "customizationId": {
            "startsWith": "urn:cen.eu:en16931:2017"
          },
          "sellerCountry": [
            "FR"
          ],
          "buyerCountry": [
            "FR"
          ]
        }
      ],
      "requires": [
        "en16931"
      ],
      "source": {
        "type": "github-release-archive",
        "repo": "fnfempe/France_RFE"
      },
      "entries": {
        "*": [
          {
            "path": "*/FNFE_RFE_INVOICE/UBL/EN16931/2xslt/BR-FR-Flux2-Schematron-UBL.xslt",
            "format": "xslt"
          }
        ]
      },
      "license": "Apache-2.0",
      "homepage": "https://github.com/fnfempe/France_RFE"
    },
    {
      "id": "fr-ctc-extended",
      "label": "France EXTENDED-CTC-FR",
