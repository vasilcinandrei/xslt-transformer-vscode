{
  "$schema": "../schemas/rules-catalog.schema.json",
  "version": 1,
  "updated": "2026-11-10",
  "packs": [
    {
      "id": "en16931",
      "label": "EN16931 (CEN core rules)",
      "country": "EU",
      "generic": true,
      "description": "European e-invoicing core business rules. Base for most national CIUS.",
      "documentTypes": [
        "Invoice",
        "CreditNote"
      ],
      "match": [
        {
          "customizationId": {
            "startsWith": "urn:cen.eu:en16931:2017"
          }
        }
      ],
      "source": {
        "type": "github-release-asset",
        "repo": "ConnectingEurope/eInvoicing-EN16931",
        "asset": "^en16931-ubl-.*\\.zip$"
      },
      "entries": {
        "*": [
          {
            "path": "xslt/EN16931-UBL-validation.xslt",
            "format": "xslt"
          }
        ]
      },
      "bundled": {
        "*": [
          "schematron/en16931/EN16931-UBL-validation.xslt"
        ]
      },
      "license": "EUPL-1.2",
      "homepage": "https://github.com/ConnectingEurope/eInvoicing-EN16931"
    },
    {
      "id": "peppol-bis",
      "label": "Peppol BIS Billing 3.0",
      "country": "Peppol",
      "description": "Peppol BIS Billing 3.0 with its own copy of the CEN rules. Includes national rules for NO, SE, DK, IT, NL, DE, GR, IS and SK, which switch on based on the seller's country.",
      "documentTypes": [
        "Invoice",
        "CreditNote"
      ],
      "match": [
        {
          "customizationId": {
            "startsWith": "urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:billing:3.0"
          }
        }
      ],
      "replaces": [
        "en16931"
      ],
      "source": {
        "type": "github-release-archive",
        "repo": "OpenPEPPOL/peppol-bis-invoice-3"
      },
      "entries": {
        "*": [
          {
            "path": "*/rules/sch/CEN-EN16931-UBL.sch",
            "format": "sch"
          },
          {
            "path": "*/rules/sch/PEPPOL-EN16931-UBL.sch",
            "format": "sch"
          }
        ]
      },
      "bundled": {
        "*": [
          "schematron/peppol/CEN-EN16931-UBL.xslt",
          "schematron/peppol/PEPPOL-EN16931-UBL.xslt"
        ]
      },
      "homepage": "https://docs.peppol.eu/poacc/billing/3.0/"
    },
    {
      "id": "xrechnung",
      "label": "XRechnung 3.0",
      "country": "DE",
      "description": "German CIUS and extension (KoSIT). Runs together with the EN16931 rules.",
      "documentTypes": [
        "Invoice",
        "CreditNote"
      ],
      "match": [
        {
          "customizationId": {
            "contains": "urn:xeinkauf.de:kosit:xrechnung_3.0"
          }
        }
      ],
      "requires": [
        "en16931"
      ],
      "source": {
        "type": "github-release-asset",
        "repo": "itplr-kosit/xrechnung-schematron",
        "asset": "^xrechnung-.*-schematron-.*\\.zip$"
      },
      "entries": {
        "*": [
          {
            "path": "schematron/ubl/XRechnung-UBL-validation.xsl",
            "format": "xslt"
          }
        ]
      },
      "license": "Apache-2.0",
      "homepage": "https://github.com/itplr-kosit/xrechnung-schematron"
    },
