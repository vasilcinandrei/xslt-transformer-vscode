{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UBL Validator project configuration",
  "type": "object",
  "required": ["version", "profiles"],
  "properties": {
    "version": { "const": 1 },
    "defaultProfile": { "type": "string", "description": "Profile offered first when several are enabled." },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sourceXml", "xsltStylesheet"],
        "properties": {
          "name": { "type": "string" },
          "sourceXml": { "type": "string", "description": "Input XML, relative to this file." },
          "xsltStylesheet": { "type": "string", "description": "XSLT stylesheet, relative to this file." },
          "validationScope": { "enum": ["full", "xsd-only", "business-rules-only"], "default": "full" },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
